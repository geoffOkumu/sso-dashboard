generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name               String
  email              String
  emailVerified      Boolean              @default(false)
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  twoFactorEnabled   Boolean?             @default(false)
  globalRole         String               @default("EMPLOYEE")
  status             String               @default("INVITED")
  securityVersion    Int                  @default(1)
  assignments        UserPlatformAccess[]
  auditEntries       AuditLog[]
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String              @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityVersion    Int                 @default(1)
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId], map: "account_provider_account_unique")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model OauthClient {
  id                               String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?               @db.Uuid
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  platformRegistration PlatformClient?

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @db.Uuid
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?            @db.Uuid
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @db.Uuid
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

model RateLimit {
  id          String @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum PlatformType {
  SSO
  LINK
}

model Platform {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  slug         String               @unique
  description  String
  icon         String               @default("layers")
  launchUrl    String
  type         PlatformType         @default(SSO)
  enabled      Boolean              @default(true)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  clients      PlatformClient[]
  roles        PlatformRole[]
  permissions  PlatformPermission[]
  assignments  UserPlatformAccess[]
}

model PlatformClient {
  id            String      @id @default(uuid()) @db.Uuid
  platformId    String      @db.Uuid
  platform      Platform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  oauthClientId String      @unique
  oauthClient   OauthClient @relation(fields: [oauthClientId], references: [clientId], onDelete: Cascade)
  name          String
  environment   String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([platformId])
}

model PlatformRole {
  id          String               @id @default(uuid()) @db.Uuid
  platformId  String               @db.Uuid
  platform    Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  key         String
  name        String
  createdAt   DateTime             @default(now())
  permissions RolePermission[]
  assignments UserPlatformAccess[]
  invitations InvitationGrant[]

  @@unique([platformId, key])
  @@unique([id, platformId])
}

model PlatformPermission {
  id          String           @id @default(uuid()) @db.Uuid
  platformId  String           @db.Uuid
  platform    Platform         @relation(fields: [platformId], references: [id], onDelete: Cascade)
  key         String
  description String
  roles       RolePermission[]

  @@unique([platformId, key])
  @@unique([id, platformId])
}

model RolePermission {
  platformId   String             @db.Uuid
  roleId       String             @db.Uuid
  permissionId String             @db.Uuid
  role         PlatformRole       @relation(fields: [roleId, platformId], references: [id, platformId], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId, platformId], references: [id, platformId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId, platformId])
}

model UserPlatformAccess {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId String       @db.Uuid
  platform   Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  roleId     String       @db.Uuid
  role       PlatformRole @relation(fields: [roleId, platformId], references: [id, platformId])
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, platformId])
  @@index([roleId, platformId])
  @@index([platformId])
}

model Invitation {
  id         String            @id @default(uuid()) @db.Uuid
  email      String            @unique
  name       String
  globalRole String            @default("EMPLOYEE")
  tokenHash  String            @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  grants     InvitationGrant[]
}

model InvitationGrant {
  id           String       @id @default(uuid()) @db.Uuid
  invitationId String       @db.Uuid
  invitation   Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  platformId   String       @db.Uuid
  roleId       String       @db.Uuid
  role         PlatformRole @relation(fields: [roleId, platformId], references: [id, platformId])
  expiresAt    DateTime?

  @@unique([invitationId, platformId])
  @@index([roleId, platformId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetId   String?
  platformId String?  @db.Uuid
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([platformId, createdAt])
  @@index([action, createdAt])
}

model RequestLimit {
  id        String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
