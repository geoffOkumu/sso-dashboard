{
  "name": "permit-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "dev:crm": "pnpm --dir apps/demo-crm dev",
    "dev:analytics": "pnpm --dir apps/demo-analytics dev",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --import tsx scripts/test-isolated.ts db",
    "test:e2e": "node --import tsx scripts/test-isolated.ts e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx scripts/seed.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "db:check": "node --import tsx scripts/db-check.ts",
    "maintenance": "node --import tsx scripts/maintenance.ts",
    "format": "prettier --write .",
    "setup:env": "node --import tsx scripts/setup-env.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-slot": "1.2.4",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.3.1",
    "lucide-react": "0.577.0",
    "next": "16.4.2",
    "nodemailer": "10.1.2",
    "openid-client": "6.8.8",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.13",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.12",
    "better-call": "1.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jose": "6.2.12",
    "prettier": "3.8.1",
    "prisma": "6.19.2",
    "smtp-server": "3.19.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "overrides": {
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.1"
  }
}
